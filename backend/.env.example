# Backend Environment Configuration
# Copy this file to .env and adjust values as needed for your environment

# ===================
# Flask Configuration
# ===================

# CORS allowed origin (frontend URL)
# For development: http://127.0.0.1:3000 or http://localhost:3000
# For production: your actual frontend domain
CORS_ORIGIN=http://127.0.0.1:3000

# Flask secret key for session management
# IMPORTANT: Change this in production to a secure random string
SECRET_KEY=parking-booking-dev-key-change-in-production

# Flask debug mode (true/false)
FLASK_DEBUG=false

# Server port
PORT=5000

# ===================
# AI Configuration
# ===================

# AI provider: 'local' for GGUF model, 'external' for API calls
AI_PROVIDER=external

# Path to GGUF model file (relative to backend directory or absolute)
AI_MODEL_PATH=models/ai-model.gguf

# External AI API URL (for fallback or when AI_PROVIDER=external)
# For Google Gemini, use: https://generativelanguage.googleapis.com/v1beta/models/gemini-2.0-flash:generateContent
# Or leave as default - the code will use Gemini API directly
AI_EXTERNAL_API_URL=https://generativelanguage.googleapis.com/v1beta/models/gemini-2.0-flash:generateContent

# Google Gemini API key (required if using Gemini)
# Get your API key from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Fallback: OpenAI API key (if Gemini not configured)
AI_EXTERNAL_API_KEY=

# AI generation parameters
AI_TEMPERATURE=0.7

# Maximum tokens in AI response
AI_MAX_TOKENS=512

# Context window size (number of tokens)
# Lower values use less memory but provide less context
AI_N_CTX=2048